---
import type { ImageMetadata } from 'astro';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import SlideShow from '../components/SlideShow.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const slideshowImages = Object.values(
	import.meta.glob('../assets/slideshow/*.{jpg,jpeg,png,webp,avif}', { eager: true })
).map((image) => (image as { default: ImageMetadata }).default);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<SlideShow images={slideshowImages} />

			<i>
				La <strong>Banda Antonio Vivaldi</strong> è lieta di conoscerti.
			</i>

			<p>
				In questo sito trovi foto, contenuti, informazioni sulla nostra
				banda. Speriamo di fare colpo!
			</p>

			<i>Pronto per altre informazioni?</i>

			<p>
				Scopri di più su di noi. Vieni a una nostra prova o concerto.
				Diventa socio.
			</p>

			<p><a href="/contattaci/">Scrivici, ci fa piacere!</a></p>
		</main>
		<Footer />
	</body>
</html>

<style>
	main {
		padding: 0 1em 3em;
	}
</style>
