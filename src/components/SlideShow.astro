---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
	images: Array<ImageMetadata | string>;
}

const { images } = Astro.props;
---

<section class="slideshow" aria-label="Slideshow della Banda Antonio Vivaldi">
	<div class="slideshow-track">
		{images.map((image, index) => (
			<div class:list={["slideshow-slide", index === 0 && 'is-active']} class="slideshow-slide">
				{typeof image === 'string' ? (
					<img
						src={image}
						alt="Foto della Banda Antonio Vivaldi"
						class="slideshow-image"
						loading={index === 0 ? 'eager' : 'lazy'}
					/>
				) : (
					<Image
						src={image}
						alt="Foto della Banda Antonio Vivaldi"
						class="slideshow-image"
						loading={index === 0 ? 'eager' : 'lazy'}
					/>
				)}
			</div>
		))}
	</div>
	<div class="slideshow-controls" aria-label="Controlli slideshow">
		{images.map((_, index) => (
			<button
				class:list={['slide-dot', index === 0 && 'is-active']}
				data-index={index}
				aria-label={`Vai alla slide ${index + 1}`}
			></button>
		))}
	</div>
</section>

<script>
	const slides = Array.from(document.querySelectorAll<HTMLElement>('.slideshow-slide'));
	const dots = Array.from(document.querySelectorAll<HTMLButtonElement>('.slide-dot'));

	let currentIndex = 0;

	function showSlide(index: number) {
		currentIndex = index;

		for (let i = 0; i < slides.length; i++) {
			slides[i].classList.toggle('is-active', i === currentIndex);
			dots[i].classList.toggle('is-active', i === currentIndex);
		}
	}

	if (slides.length > 0) {
		showSlide(0);

		setInterval(() => {
			showSlide((currentIndex + 1) % slides.length);
		}, 5000);

		dots.forEach((dot) => {
			dot.addEventListener('click', () => {
				showSlide(Number(dot.dataset.index));
			});
		});
	}
</script>

<style>
	.slideshow {
		position: relative;
		width: 100vw;
		margin-left: calc(50% - 50vw);
		overflow: hidden;
		background: #0f172a;
		margin-bottom: 1rem;
	}

	.slideshow-track {
		position: relative;
		height: 420px;
	}

	.slideshow-slide {
		position: absolute;
		inset: 0;
		opacity: 0;
		transition: opacity 0.8s ease;
	}

	.slideshow-slide.is-active {
		opacity: 1;
	}

	.slideshow-image {
		display: block;
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.slideshow-controls {
		position: absolute;
		bottom: 1rem;
		left: 50%;
		transform: translateX(-50%);
		display: flex;
		gap: 0.6rem;
		z-index: 2;
	}

	.slide-dot {
		width: 0.75rem;
		height: 0.75rem;
		padding: 0;
		border: 2px solid #ffffff;
		border-radius: 999px;
		background: transparent;
		cursor: pointer;
	}

	.slide-dot.is-active {
		background: #ffffff;
	}
</style>
